{
    "name":  "dsh-mcpaudit",
    "version":  "1.0.0",
    "description":  "Mingleng mcpaudit for DeepSeek Harness - the audit & security plugin for DSH. Scans skills and MCP configs for prompt injection, homoglyphs, hidden Unicode, dangerous shell, credential leaks, path traversal, malicious network I/O and more. v1.0: 17 rules, YAML rule overrides, multi-format reports (JSON/Markdown/SARIF), incremental scan, lifecycle auto-scan hooks, audit logging.",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "guard-rules.yaml",
                  "README.md",
                  "README.zh.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node test/smoke.mjs && node test/robust.mjs"
                },
    "devDependencies":  {
                            "typescript":  "^5.5.0",
                            "@types/node":  "^22.0.0"
                        },
    "license":  "MIT"
}
